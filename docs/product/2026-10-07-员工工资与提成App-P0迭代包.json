  "money_cases": [
    {
      "id": "MONEY-PAY-001",
      "source": "员工薪酬方案与月度考勤汇总",
      "formula_or_snapshot": "日薪=月固定工资÷当月应出勤天数；应发=固定工资折算+提成+奖金+补贴；实发=应发−扣款",
      "missing_value_policy": "考勤、归属或应计项缺失时工资单不可确认，不得按0计算",
      "cross_page_expectation": "工资单、应付、发放流水和工资条金额一致"
    },
    {
      "id": "MONEY-PAY-002",
      "source": "主合同签约额、手工提成比例与有效回款",
      "formula_or_snapshot": "累计应释放=min(提成金额,提成金额×累计有效回款÷主合同签约额)；本次释放=max(0,累计应释放−已释放)",
      "missing_value_policy": "主合同签约额或比例缺失时提成不可计提；不得按0计算",
      "cross_page_expectation": "提成详情、工资单、应付和资金台账可追溯同一释放事实"
    },
    {
      "id": "MONEY-PAY-003",
      "source": "工资项和提成项的项目/企业归属",
      "formula_or_snapshot": "项目归属进入项目成本，企业归属进入企业费用；一项只能一个归属",
      "missing_value_policy": "归属不完整时阻断确认，禁止重复计成本",
      "cross_page_expectation": "项目账本、企业费用、工资单和应付口径一致"
    },
    {
      "id": "MONEY-PAY-004",
      "source": "员工发放与资金台账",
      "formula_or_snapshot": "确认工资单/提成时生成应付并计成本，发放时核销应付并写Ledger",
      "missing_value_policy": "发放失败保留未清应付；重试不得重复写流水",
      "cross_page_expectation": "工资单、应付、发放记录和资金台账一致"
    }
  ],
