  "scenarios": [
    {
      "id": "SCN-PAY-001",
      "user": "财务、店长、BOSS",
      "trigger": "月末结算固定工资",
      "precondition": "员工已配置薪酬方案，当月考勤已申报",
      "action": "店长确认考勤，财务生成并提交工资单，BOSS确认",
      "system_next": "生成员工工资应付并计成本，财务发放后写资金台账",
      "exception": "考勤未确认时禁止确认工资单；发放失败保留应付，重试不重复写流水"
    },
    {
      "id": "SCN-PAY-002",
      "user": "设计师、财务、BOSS",
      "trigger": "主合同签约并发生客户回款",
      "precondition": "提成基数、手工比例和项目归属已确认",
      "action": "签约时计提，回款后按累计有效回款比例自动释放",
      "system_next": "形成提成应付、项目成本、员工发放和工资条明细",
      "exception": "退款或跨期导致负向调整时进入下期，不反改已发放历史"
    },
    {
      "id": "SCN-PAY-003",
      "user": "店长",
      "trigger": "查看本店员工工资",
      "precondition": "企业启用员工薪酬且店长拥有本店工资配置权限",
      "action": "查看本店员工应发、扣款和实发构成",
      "system_next": "仅返回本店数据，敏感字段脱敏并记录访问留痕",
      "exception": "跨店、跨企业、查看BOSS或财务工资时拒绝且不泄露存在性"
    },
    {
      "id": "SCN-PAY-004",
      "user": "普通员工",
      "trigger": "工资条发布或提成状态变化",
      "precondition": "员工属于当前企业且工资周期已发布",
      "action": "查看本人工资条、提成和考勤",
      "system_next": "只展示本人应发、扣款、实发和提成释放/发放状态",
      "exception": "访问同事工资条或跨企业数据时拒绝"
    }
  ],
