      "frameDurationMs": 2800,
      "caption": "老板首页：先看需要处理的经营事实"
    },
    {
      "id": "S02",
      "action": "reLaunch",
      "url": "/pages/customer/list",
      "waitMs": 2200,
      "frameDurationMs": 2200,
      "caption": "客户经营：客户、房屋和下一步"
    },
    {
      "id": "S03",
      "action": "reLaunch",
      "url": "/pages/project/list",
      "waitMs": 2200,
      "frameDurationMs": 2200,
      "caption": "项目经营：项目阶段、风险和金额"
    },
    {
      "id": "S04",
      "action": "navigateTo",
      "url": "/subpackages/project/pages/detail?id=${projectid}",
