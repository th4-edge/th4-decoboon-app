      "waitMs": 2600,
      "frameDurationMs": 2600,
      "optional": true,
      "caption": "项目详情：现场、任务和业主同频"
    },
    {
      "id": "S05",
      "action": "reLaunch",
      "url": "/pages/finance/index",
      "waitMs": 2400,
      "frameDurationMs": 2400,
      "caption": "财务总览：收款、成本和经营口径"
