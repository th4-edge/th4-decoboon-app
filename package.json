{
  "name": "th4-decoboon-app",
  "version": "1.0.14",
  "private": true,
  "description": "装得清 · 装企协同微信小程序（uni-app Vue3 + TypeScript + Vite）",
  "scripts": {
    "dev": "npm run dev:mp-weixin",
    "start": "npm run dev:mp-weixin",
    "dev:h5": "uni",
    "dev:mp-weixin": "node scripts/verify-dev-api-base.mjs && uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:release": "npm run type-check && npm run check:release-env && npm run build:mp-weixin && npm run check:subpackages",
    "type-check": "vue-tsc --noEmit",
    "check:release-env": "node scripts/verify-release-env.mjs",
    "check:subpackages": "node scripts/check-subpackages.mjs",
    "check:onboarding": "node scripts/verify-onboarding-contract.mjs",
    "check:registration": "node scripts/verify-registration-flow-contract.mjs",
    "check:document": "node scripts/verify-document-contract.mjs",
    "check:plan": "node scripts/verify-plan-contract.mjs",
    "check:home": "node scripts/verify-homepage-contract.mjs",
    "check:action": "node scripts/verify-action-contract.mjs",
    "check:finance-ia": "node scripts/verify-finance-ia-contract.mjs",
    "check:dev-api": "node scripts/verify-dev-api-base.mjs",
    "verify:mp-weixin": "node scripts/verify-customer-source-contract.mjs && node scripts/verify-employee-display-contract.mjs && npm run check:onboarding && npm run check:document && npm run check:plan && npm run check:home && npm run check:action && npm run check:finance-ia && npm run check:registration && npm run check:upload && npm run check:customer-admin && npm run check:navigation && npm run check:dev-api && node scripts/verify-money-format.mjs && npm run type-check && npm run build:mp-weixin && npm run check:subpackages",
    "check:upload": "node scripts/verify-upload-diagnostics-contract.mjs",
    "check:customer-admin": "node scripts/verify-customer-admin-contract.mjs",
    "record:site": "node scripts/recording/run-scenario.mjs scripts/recording/scenarios/website-boss-overview.json",
    "record:site:dry": "node scripts/recording/run-scenario.mjs scripts/recording/scenarios/website-boss-overview.json --no-record",
    "record:owner": "node scripts/recording/run-scenario.mjs scripts/recording/scenarios/website-owner-journey.json",
    "record:owner:dry": "node scripts/recording/run-scenario.mjs scripts/recording/scenarios/website-owner-journey.json --no-record",
    "check:navigation": "node scripts/verify-navigation-contract.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020520260829001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5020520260829001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020520260829001",
    "@vue/runtime-core": "3.4.21",
    "miniprogram-automator": "^0.12.1",
    "sass": "^1.77.8",
    "typescript": "~5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "^2.0.29"
  }
}
