{
  "name": "th4-decoboon-app",
  "version": "1.0.0",
  "private": true,
  "description": "装得清 · 装企协同微信小程序（uni-app Vue3 + TypeScript + Vite）",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:release": "npm run type-check && npm run check:release-env && npm run build:mp-weixin && npm run check:subpackages",
    "type-check": "vue-tsc --noEmit",
    "check:release-env": "node scripts/verify-release-env.mjs",
    "check:subpackages": "node scripts/check-subpackages.mjs",
    "verify:mp-weixin": "npm run type-check && npm run build:mp-weixin && npm run check:subpackages"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020520260829001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5020520260829001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020520260829001",
    "@vue/runtime-core": "3.4.21",
    "sass": "^1.77.8",
    "typescript": "~5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "^2.0.29"
  }
}
